def num(n):#sum(1to n)
    total=0
    for i in range(1,n+1):
        total=total+i
    return total
n=int(input("number"))
results=num(n)
print(results)

def simpleinterest(p,r,t):#simple interest
    si=p*r*t/100
    totalamount=p+si
    return si,totalamount
p=int(input("p="))
r=int(input("r="))
t=int(input("t="))
result=simpleinterest(p,r,t)
print(result)

def ci(p,r,t): #compound interest
    total=p*(1+r/100)*t
    ci=total-p
    return total,ci
p=int(input("p="))
r=int(input("r="))
t=int(input("t="))
result=ci(p,r,t)
print(result)

